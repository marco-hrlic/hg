# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Experiment outputs: keep the directory layout, not the artifacts.
data/raw/*
data/anchors/*
data/splits/*
data/processed/*
# One directory per run: results/<timestamp>_<experiment>/. These hold the
# item-level artifacts -- prediction matrices and grounding episodes -- which
# are large (tens of MB) and regenerable from config + seed. The four patterns
# below them predate per-run directories and no longer match anything a run
# writes; they are kept so an older layout stays ignored.
results/*/
results/predictions/*
results/matrices/*
results/bootstrap/*
results/figures/*
!**/.gitkeep

# Model weights and adapters are never committed.
checkpoints/
adapters/
*.safetensors
*.bin
*.gguf

# Local overrides
configs/**/local_*.yaml
.env

# Written by scripts/spark_deploy.sh right before each sync, so a Spark
# manifest can recover git provenance despite the sync excluding .git.
/DEPLOY_GIT_SHA
/DEPLOY_GIT_DIRTY
